<Window x:Class="ChestTracker.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="260" SizeToContent="Height" MinHeight="36" MaxHeight="200" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False">
 <Border Background="#ED101216" CornerRadius="8" BorderBrush="#383D46" BorderThickness="1" Padding="11,7">
  <StackPanel>
   <Grid Height="20"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="Dot" Width="7" Height="7" Fill="#7E8795" HorizontalAlignment="Left"/><TextBlock x:Name="Label" Grid.Column="1" Text="ChestTracker | Unbekannt" Foreground="#F7F8FA" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
   <ItemsControl x:Name="PeerRows" IsHitTestVisible="False"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="23"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="{Binding Color}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#B8C4D6" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
 </Border>
</Window>
