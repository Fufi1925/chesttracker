<Window x:Class="ChestTracker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ChestTracker" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" MinWidth="380" MinHeight="520" Background="#090A0C" Foreground="#F7F8FA" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
 <Window.Resources><Storyboard x:Key="BackdropMotion" RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="OrbTransform" Storyboard.TargetProperty="X" From="-60" To="100" Duration="0:0:28"/><DoubleAnimation Storyboard.TargetName="OrbTransform" Storyboard.TargetProperty="Y" From="40" To="-70" Duration="0:0:32"/></Storyboard></Window.Resources>
 <Border x:Name="WindowBorder" BorderBrush="#30343C" BorderThickness="1"><Grid>
  <Grid x:Name="LoginView" ClipToBounds="True">
   <Grid x:Name="AnimationHost" IsHitTestVisible="False"><Ellipse Width="1000" Height="1000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-550,-180,0,0" Opacity="0.6"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#252B37"/><GradientStop Offset="1" Color="#00252B37"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><TranslateTransform x:Name="OrbTransform"/></Ellipse.RenderTransform></Ellipse><Ellipse Width="780" Height="780" Stroke="#20252E" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="640,200,0,0"/><Ellipse Width="940" Height="940" Stroke="#161B23" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="640,200,0,0"/></Grid>
   <Grid Margin="44,30" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="27" Margin="0,0,10,0"/><TextBlock Text="ChestTracker" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Border BorderBrush="#353B46" BorderThickness="1" CornerRadius="4" Padding="7,4" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="PRIVAT" FontSize="8" Foreground="#818B9B"/></Border></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="—" Style="{StaticResource QuietButton}" Click="Minimize_Click" AutomationProperties.Name="Minimieren"/><Button Content="✕" Style="{StaticResource QuietButton}" Click="Close_Click" AutomationProperties.Name="Schließen"/></StackPanel></Grid>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" MaxHeight="800" Margin="20,100,20,70"><StackPanel Width="360" HorizontalAlignment="Center">
    <Border Width="52" Height="52" Background="#1C2027" BorderBrush="#363D49" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,25"><TextBlock Text="◇" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="DEIN PRIVATER KREIS" FontSize="10" Foreground="#828C9E" TextAlignment="Center"/><TextBlock Text="Deine Runde wartet." FontSize="30" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,12"/><TextBlock Text="Melde dich mit deinem ChestTracker-Konto an." FontSize="12" Foreground="#9299A6" TextAlignment="Center" Margin="0,0,0,30"/>
    <TextBlock Text="Benutzername" FontSize="11" Foreground="#B3BAC6" Margin="0,0,0,9"/><TextBox x:Name="Username" AutomationProperties.Name="Benutzername" MaxLength="32" Margin="0,0,0,20"/><TextBlock Text="Passwort" FontSize="11" Foreground="#B3BAC6" Margin="0,0,0,9"/><PasswordBox x:Name="Password" AutomationProperties.Name="Passwort" MaxLength="128" Margin="0,0,0,24"/>
    <Button x:Name="LoginButton" Content="Anmelden  ↗" Style="{StaticResource PrimaryButton}" Click="Login_Click" IsDefault="True"/><TextBlock x:Name="LoginStatus" TextWrapping="Wrap" FontSize="11" Foreground="#D6A6A4" TextAlignment="Center" Margin="0,15,0,0"/>
    <Expander Header="Serveradresse" Margin="0,20,0,0" FontSize="10"><StackPanel Margin="0,14,0,0"><TextBox x:Name="ServerUrl" Text="https://chesttracker-fufi1925s-projects.vercel.app" FontSize="10"/><Button Content="Verbindung prüfen" Click="Check_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,7,0,0"/></StackPanel></Expander><TextBlock Text="Keine Epic-Anmeldung. Nur dein privates Konto." FontSize="10" Foreground="#626E81" TextAlignment="Center" Margin="0,24,0,0"/>
   </StackPanel></ScrollViewer><TextBlock Text="ChestTracker  /  Windows" FontSize="10" Foreground="#525E70" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,27"/>
  </Grid>
  <Grid x:Name="AccountView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border BorderBrush="#252A32" BorderThickness="0,0,0,1" Background="#101216" MouseLeftButtonDown="Header_Drag"><Grid Margin="20,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◇" FontSize="20" Margin="0,0,8,0"/><TextBlock Text="ChestTracker" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="—" Click="Minimize_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Minimieren"/><Button Content="✕" Click="Close_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Schließen"/></StackPanel></Grid></Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="25,27,25,22">
    <Grid><StackPanel><TextBlock Text="ANGEMELDET ALS" FontSize="9" Foreground="#778397"/><TextBlock x:Name="AccountName" Text="Dein Name" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"><Ellipse x:Name="ServerDot" Fill="#727C8C" Width="5" Height="5" Margin="0,0,6,0"/><TextBlock x:Name="ServerState" Text="Verbinden" FontSize="9" Foreground="#8794A8"/></StackPanel></Grid>
    <UniformGrid Columns="3" Margin="0,24,0,24"><Border Background="#15181E" BorderBrush="#2A303A" BorderThickness="1" CornerRadius="7" Padding="12,13" Margin="0,0,7,0"><StackPanel><TextBlock Text="TRUHEN" FontSize="8" Foreground="#7C899D"/><TextBlock x:Name="TotalChests" Text="—" FontSize="22" Margin="0,9,0,0"/></StackPanel></Border><Border Background="#15181E" BorderBrush="#2A303A" BorderThickness="1" CornerRadius="7" Padding="12,13" Margin="0,0,7,0"><StackPanel><TextBlock Text="MATCHES" FontSize="8" Foreground="#7C899D"/><TextBlock x:Name="TotalMatches" Text="—" FontSize="22" Margin="0,9,0,0"/></StackPanel></Border><Border Background="#15181E" BorderBrush="#2A303A" BorderThickness="1" CornerRadius="7" Padding="12,13"><StackPanel><TextBlock Text="Ø / MATCH" FontSize="8" Foreground="#7C899D"/><TextBlock x:Name="AverageChests" Text="—" FontSize="22" Margin="0,9,0,0"/></StackPanel></Border></UniformGrid>
    <Border Background="#12151A" BorderBrush="#2C323D" BorderThickness="1" CornerRadius="9" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FORTNITE" FontSize="8" Foreground="#738198"/><TextBlock x:Name="GameStatus" Text="Erfassung gestoppt" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="MatchStatus" Text="Kein laufendes Match" FontSize="10" Foreground="#78869D" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><Ellipse x:Name="GameDot" Grid.Column="1" Width="7" Height="7" Fill="#6F7C90" VerticalAlignment="Top" Margin="12,3,0,0"/></Grid></Border>
    <CheckBox Margin="0,13,0,0" x:Name="EnableCapture" Checked="CaptureSetting_Changed" Unchecked="CaptureSetting_Changed"><TextBlock Text="Bildanalyse und Truhenzählung aktivieren" FontSize="10" Foreground="#BDC7D7" TextWrapping="Wrap"/></CheckBox>
    <Button x:Name="GameButton" Content="Fortnite starten" Style="{StaticResource PrimaryButton}" Margin="0,19,0,15" Click="Game_Click"/><Grid Margin="0,0,0,16"><TextBlock Text="Overlay-Hotkey" FontSize="11" Foreground="#8996AA" VerticalAlignment="Center"/><Button x:Name="HotkeyButton" Content="O  ·  Ändern" HorizontalAlignment="Right" Padding="12,8" Click="Hotkey_Click"/></Grid><TextBlock x:Name="DetectionStatus" Text="Bildanalyse nicht aktiviert." FontSize="10" Foreground="#94A2BA" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock x:Name="ConnectionText" FontSize="10" Foreground="#8B9AAF" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <Expander Header="Einstellungen und Erkennung" FontSize="10"><StackPanel Margin="0,15,0,0"><TextBlock Text="Nur das sichtbare Fortnite-Fenster wird lokal ausgewertet. Keine Bilder werden hochgeladen. Experimentelle Erkennung anhand eines Referenzclips; weitere Aufnahmen und ein Live-Test am PC fehlen." FontSize="10" Foreground="#74839A" TextWrapping="Wrap" Margin="0,10,0,12"/><Button Content="Website öffnen  ↗" Click="Website_Click" Margin="0,0,0,8"/><Button Content="Offline-Replay testen" Click="Replay_Click" Margin="0,0,0,8"/><TextBlock x:Name="QueueText" Text="Alle Ereignisse synchronisiert" FontSize="9" Foreground="#67768D" Margin="0,5,0,10"/><Button Content="Abmelden" Click="Logout_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </Grid>
  <Border x:Name="ChangePanel" Visibility="Collapsed" Background="#F5090A0C"><StackPanel Width="330" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Dein eigenes Passwort." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Ersetze dein Startpasswort, bevor es losgeht." FontSize="12" Foreground="#9299A6" Margin="0,12,0,28"/><TextBlock Text="Neues Passwort · mindestens 12 Zeichen" FontSize="11" Margin="0,0,0,9"/><PasswordBox x:Name="NewPassword" MaxLength="128"/><TextBlock Text="Neues Passwort wiederholen" FontSize="11" Margin="0,18,0,9"/><PasswordBox x:Name="ConfirmPassword" MaxLength="128"/><TextBlock x:Name="ChangeError" TextWrapping="Wrap" Foreground="#D6A6A4" FontSize="11" Margin="0,12,0,0"/><Button x:Name="ChangeButton" Content="Passwort speichern" Style="{StaticResource PrimaryButton}" Click="Change_Click" Margin="0,20,0,0"/><Button Content="Zurück zur Anmeldung" Click="CancelChange_Click" Style="{StaticResource QuietButton}" Margin="0,12,0,0"/></StackPanel></Border>
 </Grid></Border>
</Window>
