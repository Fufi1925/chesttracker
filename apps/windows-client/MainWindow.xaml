<Window x:Class="ChestTracker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ChestTracker" Title="ChestTracker" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" MinWidth="380" MinHeight="520" Background="#090C10" Foreground="#F4F6F5" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <Storyboard x:Key="BackdropMotion" RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="OrbTransform" Storyboard.TargetProperty="X" From="-25" To="55" Duration="0:0:28"/><DoubleAnimation Storyboard.TargetName="OrbTransform" Storyboard.TargetProperty="Y" From="15" To="-35" Duration="0:0:32"/></Storyboard>
 </Window.Resources>
 <Border x:Name="WindowBorder" BorderBrush="#3B464E" BorderThickness="1"><Grid>
  <Grid x:Name="LoginView" ClipToBounds="True">
   <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#090C10"/><GradientStop Offset=".49" Color="#11171D"/><GradientStop Offset="1" Color="#080B0F"/></LinearGradientBrush></Grid.Background>
   <Grid x:Name="AnimationHost" IsHitTestVisible="False">
    <Ellipse Width="800" Height="800" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-100,-100,0,0"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#267EA7A1"/><GradientStop Offset="1" Color="#007EA7A1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><TranslateTransform x:Name="OrbTransform"/></Ellipse.RenderTransform></Ellipse>
    <local:AmbientBackdrop x:Name="LoginBackdrop"/>
   </Grid>
   <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,18,22,0"><Button Content="—" Style="{StaticResource QuietButton}" Click="Minimize_Click" AutomationProperties.Name="Minimieren"/><Button Content="✕" Style="{StaticResource QuietButton}" Click="Close_Click" AutomationProperties.Name="Schließen"/></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="20,65,20,55" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
    <Border x:Name="LoginCard" Width="414" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Padding="42,38" CornerRadius="22" BorderBrush="#5A7C8B8C" BorderThickness="1" Background="{StaticResource GlassBrush}" HorizontalAlignment="Center">
     <Border.Effect><DropShadowEffect BlurRadius="55" ShadowDepth="15" Opacity=".24" Color="Black"/></Border.Effect>
     <StackPanel>
      <TextBlock Text="Willkommen zurück." FontSize="30" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <TextBlock Text="Melde dich mit deinem ChestTracker-Konto an." FontSize="12" Foreground="#B2B9C0" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,29"/>
      <TextBlock Text="Benutzername" FontSize="12" FontWeight="Medium" Foreground="#E0E5E5" Margin="0,0,0,10"/>
      <TextBox x:Name="Username" AutomationProperties.Name="Benutzername" MaxLength="32" Height="51" Margin="0,0,0,19"/>
      <TextBlock Text="Passwort" FontSize="12" FontWeight="Medium" Foreground="#E0E5E5" Margin="0,0,0,10"/>
      <Grid Height="51">
       <PasswordBox x:Name="Password" AutomationProperties.Name="Passwort" MaxLength="128" Padding="14,13,48,13" PasswordChanged="Password_Changed"/>
       <TextBox x:Name="VisiblePassword" AutomationProperties.Name="Passwort im Klartext" MaxLength="128" Padding="14,13,48,13" Visibility="Collapsed" TextChanged="VisiblePassword_Changed"/>
       <Button x:Name="RevealPassword" Style="{StaticResource QuietButton}" Width="46" HorizontalAlignment="Right" Padding="11" Click="RevealPassword_Click" AutomationProperties.Name="Passwort anzeigen" ToolTip="Passwort anzeigen">
        <Grid Width="18" Height="18"><Path Data="M 1 9 C 5 2 13 2 17 9 C 13 16 5 16 1 9 Z M 11.5 9 A 2.5 2.5 0 1 1 6.5 9 A 2.5 2.5 0 1 1 11.5 9" Stroke="#AEB7BE" StrokeThickness="1.2"/><Path x:Name="EyeSlash" Data="M 2 16 L 16 2" Stroke="#AEB7BE" StrokeThickness="1.2" Visibility="Collapsed"/></Grid>
       </Button>
      </Grid>
      <Button x:Name="LoginButton" Content="Anmelden" Style="{StaticResource PrimaryButton}" Click="Login_Click" IsDefault="True" Margin="0,27,0,0"/>
      <TextBlock x:Name="LoginStatus" TextWrapping="Wrap" FontSize="12" Foreground="#EFC7BD" Margin="0,12,0,0"/>
      <Expander Header="Servereinstellungen" Margin="0,12,0,0" FontSize="11"><StackPanel Margin="0,12,0,0"><TextBox x:Name="ServerUrl" Text="https://chesttracker-fufi1925s-projects.vercel.app" FontSize="10"/><Button Content="Verbindung prüfen" Click="Check_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,5,0,0"/></StackPanel></Expander>
     </StackPanel>
    </Border>
   </ScrollViewer>
   <TextBlock Text="ChestTracker  /  Windows" FontSize="10" Foreground="#7C8990" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"/>
  </Grid>
  <Grid x:Name="AccountView" Visibility="Collapsed" ClipToBounds="True">
   <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#10171C"/><GradientStop Offset=".5" Color="#111A20"/><GradientStop Offset="1" Color="#090E14"/></LinearGradientBrush></Grid.Background>
   <local:AmbientBackdrop x:Name="AccountBackdrop" Coins="True" Margin="0,48,0,0"/>
   <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="#384650" BorderThickness="0,0,0,1" Background="#B0141C22" MouseLeftButtonDown="Header_Drag">
     <Grid Margin="24,0,11,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M 1 5 L 4 1 L 16 1 L 19 5 L 19 17 L 1 17 Z M 1 7 L 8 7 L 8 11 L 12 11 L 12 7 L 19 7" Stroke="#B8CBC4" StrokeThickness="1.2" Width="21" Height="19" Margin="0,0,9,0"/><TextBlock Text="ChestTracker" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="—" Click="Minimize_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Minimieren"/><Button Content="✕" Click="Close_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Schließen"/></StackPanel>
     </Grid>
    </Border>
    <ScrollViewer x:Name="AccountScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="26,22,26,22">
      <Grid>
       <StackPanel><TextBlock Text="DEIN ACCOUNT" FontSize="9" Foreground="#A5B2B7"/><TextBlock x:Name="AccountName" Text="Dein Name" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis"/></StackPanel>
       <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" BorderBrush="#51636D" BorderThickness="1" Background="#B019252B" Padding="9,5" Margin="0,3,0,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ServerDot" Fill="#89979D" Width="5" Height="5" Margin="0,0,6,0"/><TextBlock x:Name="ServerState" Text="Verbinden" FontSize="9" Foreground="#C6D0D1"/></StackPanel></Border>
      </Grid>
      <Border Background="{StaticResource GlassBrush}" BorderBrush="#5066797D" BorderThickness="1" CornerRadius="14" Padding="0,12" Margin="0,16,0,18">
       <UniformGrid Columns="3">
        <StackPanel><TextBlock x:Name="TotalChests" Text="—" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Truhen" FontSize="10" Foreground="#A8B5BB" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel>
        <Border BorderBrush="#485760" BorderThickness="1,0"><StackPanel><TextBlock x:Name="TotalMatches" Text="—" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Matches" FontSize="10" Foreground="#A8B5BB" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel></Border>
        <StackPanel><TextBlock x:Name="AverageChests" Text="—" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Ø pro Match" FontSize="10" Foreground="#A8B5BB" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel>
       </UniformGrid>
      </Border>
      <Border Background="#A818242B" BorderBrush="#4855655B" BorderThickness="1" CornerRadius="12" Padding="13,11">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="GameStatus" Text="Bereit für deine Runde" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock x:Name="MatchStatus" Text="Kein laufendes Match" FontSize="10" Foreground="#A5B4BA" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Ellipse x:Name="GameDot" Grid.Column="1" Width="6" Height="6" Fill="#89979D" VerticalAlignment="Top" Margin="12,5,0,0"/></Grid>
      </Border>
      <Button x:Name="GameButton" Content="Fortnite starten" Style="{StaticResource PrimaryButton}" Margin="0,16,0,15" Click="Game_Click"/>
      <CheckBox x:Name="EnableCapture" Style="{StaticResource ToggleSwitch}" Checked="CaptureSetting_Changed" Unchecked="CaptureSetting_Changed" AutomationProperties.Name="Truhen automatisch zählen">
       <StackPanel Margin="0,0,12,0"><TextBlock Text="Truhen automatisch zählen" FontSize="11" Foreground="#E1E9E7" FontWeight="Medium"/><TextBlock Text="Bildanalyse nur auf deinem PC" FontSize="10" Foreground="#A2B2B8" Margin="0,4,0,0"/></StackPanel>
      </CheckBox>
      <Border BorderBrush="#485560" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,13,0,0"><Grid><TextBlock Text="Overlay-Hotkey" FontSize="11" Foreground="#BDC8CA" VerticalAlignment="Center"/><Button x:Name="HotkeyButton" Content="O  ·  Ändern" HorizontalAlignment="Right" Padding="12,7" Click="Hotkey_Click"/></Grid></Border>
      <TextBlock x:Name="DetectionStatus" Text="Bildanalyse nicht aktiviert." FontSize="10" Foreground="#B0C0C7" TextWrapping="Wrap" MaxHeight="42" Margin="0,14,0,0"/>
      <TextBlock x:Name="ConnectionText" FontSize="10" Foreground="#ADBEC5" TextWrapping="Wrap" MaxHeight="42" Margin="0,6,0,0"/>
      <Expander x:Name="AccountSettings" Header="Einstellungen" FontSize="10" Margin="0,14,0,0">
       <StackPanel Margin="0,10,0,0">
        <TextBlock Text="Nur das Fortnite-Fenster wird lokal ausgewertet. Keine Bilder werden hochgeladen. Die Erkennung kann Aktionen verpassen oder falsch zählen." FontSize="10" Foreground="#A7B7BF" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Button Content="Website öffnen  ↗" Click="Website_Click" Margin="0,0,0,8"/><Button Content="Offline-Replay testen" Click="Replay_Click" Margin="0,0,0,8"/>
        <TextBlock x:Name="QueueText" Text="Alle Ereignisse synchronisiert" FontSize="9" Foreground="#A3B5BE" Margin="0,5,0,10"/><Button Content="Abmelden" Click="Logout_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
  <Border x:Name="ChangePanel" Visibility="Collapsed" Background="#F5090C10">
   <Border Width="390" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource GlassBrush}" CornerRadius="22" BorderBrush="#53697073" BorderThickness="1" Padding="30">
    <StackPanel><TextBlock Text="Dein eigenes Passwort." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Ersetze dein Startpasswort, bevor es losgeht." FontSize="12" Foreground="#B2B9C0" Margin="0,12,0,26" TextWrapping="Wrap"/><TextBlock Text="Neues Passwort · mindestens 12 Zeichen" FontSize="11" Margin="0,0,0,9"/><PasswordBox x:Name="NewPassword" MaxLength="128"/><TextBlock Text="Neues Passwort wiederholen" FontSize="11" Margin="0,18,0,9"/><PasswordBox x:Name="ConfirmPassword" MaxLength="128"/><TextBlock x:Name="ChangeError" TextWrapping="Wrap" Foreground="#EFC7BD" FontSize="11" Margin="0,12,0,0"/><Button x:Name="ChangeButton" Content="Passwort speichern" Style="{StaticResource PrimaryButton}" Click="Change_Click" Margin="0,20,0,0"/><Button Content="Zurück zur Anmeldung" Click="CancelChange_Click" Style="{StaticResource QuietButton}" Margin="0,12,0,0"/></StackPanel>
   </Border>
  </Border>
 </Grid></Border>
</Window>
